{
  "manifestVersion": 1,
  "id": "com.example.process-acquisition",
  "name": "Process acquisition fixture",
  "version": "0.1.0",
  "description": "A test fixture that runs the manifest's hello-tool in start-search.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/plugin-sdk",
  "api": "hearthsound:plugin@0.5.0",
  "provides": ["acquisition"],
